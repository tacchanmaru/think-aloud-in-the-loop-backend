{
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.tabSize": 4,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": ".venv/bin/python",
  "python.languageServer": "Default",
  "python.analysis.extraPaths": ["${workspaceFolder}", ".venv/lib/python3.11/site-packages"],
  "python.autoComplete.extraPaths": ["${workspaceFolder}", ".venv/lib/python3.11/site-packages"],
  "gutterpreview.imagePreviewMaxWidth": 256,
  "gutterpreview.imagePreviewMaxHeight": 256,
  "cSpell.words": ["dotenv"]
}
